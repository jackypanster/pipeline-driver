# drive.defaults — GLOBAL machine bindings read by `coordinate.sh doctor|status`.
# One-time install:
#   mkdir -p ~/.config/pipeline-driver && cp drive.defaults.example ~/.config/pipeline-driver/drive.defaults
# Sourced by bash BEFORE the per-repo coordinate.config, so anything here is a
# default and coordinate.config always wins. Path override: $DRIVE_DEFAULTS.
# (File name + path are inherited from the retired drive.sh — tag archive/drive-final —
# and kept so existing installs keep working. drive.sh-only keys such as transport
# tuning, SKILL_MOUNTS, BOARD_OUT and NOTIFY_EXEC were removed; coordinate.sh never
# read them, and a stale copy that still sets them is harmless.)
#
# Slot bindings on this machine — machine-readable: `coordinate.sh doctor|status`
# print these, and doctor verifies each *_MODEL_EXPECT against the live pane
# footer (fail-closed when set). coordinate.config may override any of them
# (config wins). prd/arch/task run in the CC pane; impl in the PI_WORKDIR pane;
# review in the CODEX_WORKDIR pane. *_MODEL_EXPECT is a literal case-insensitive
# ASCII substring of the pane footer/title (charset is printable ASCII — control
# bytes and bytes ≥0x80 are rejected); unset = skip that check.
CC_AGENT=claude
# CC_MODEL_EXPECT=
IMPL_AGENT=pi                 # pi | kimi | ... — the TUI driven in the impl pane
IMPL_MODEL_EXPECT=glm-5.2     # e.g. kimi-k3 when IMPL_AGENT=kimi
REVIEW_AGENT=codex
REVIEW_MODEL_EXPECT=gpt-5.6

# Informational only: coordinate.sh echoes these in its machine-bindings block
# ("impl transport: ... yolo: ...") and validates nothing about them. Kept for
# operators who record the impl-pane channel / standing GATE 1 grant here.
IMPL_TRANSPORT=herdr
YOLO=0
