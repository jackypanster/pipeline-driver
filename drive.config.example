# drive.config — per-feature config for drive.sh. Copy to drive.config and edit.
# Sourced by bash, so: VAR=value, no spaces around '='.

# The local clone of the TARGET repo (the git+md state bus). The driver only ever
# reads origin/<BRANCH> refs from here; the driven impl child shares this checkout.
WORKDIR=/path/to/your/target-repo

# Trunk branch (where .pipeline metadata + the frozen spec live). Often main/master.
BRANCH=main

# The .pipeline/<feature> directory name.
FEATURE=my-feature

# --- impl model tier (A1: drive impl on Claude) -------------------------------
# Floor is haiku. May be any alias (haiku|sonnet|opus|fable) or a full model id.
IMPL_MODEL=haiku

# Optional: route impl to a non-Anthropic, Anthropic-compatible model via a gateway
# (e.g. GLM 5.2 xhigh). Leave IMPL_BASE_URL empty to use the Anthropic default.
# IMPL_AUTH_TOKEN_ENV names an EXISTING env var holding the gateway token (the token
# itself is never written here or printed).
#   IMPL_MODEL=glm-4.6
#   IMPL_BASE_URL=https://your-anthropic-compatible-gateway/v1
#   IMPL_AUTH_TOKEN_ENV=GLM_API_KEY
IMPL_BASE_URL=
IMPL_AUTH_TOKEN_ENV=

# --- impl transport --------------------------------------------------------------
# claude (default): spawn a headless `claude` child per card (settings above apply).
# orca: type "/pipeline-impl …" into a live Orca-managed TUI terminal (e.g. omp
# running GLM) via `orca terminal send`, then poll origin/<BRANCH> until the journal
# seq advances. Use when the impl model's plan only allows interactive coding tools
# (observed: bigmodel.cn coding plan rejects headless Claude Code with a fake-529).
# The TUI agent must have the pipeline-impl shim + the roles.yaml impl skill
# installed, and permissions that let it finish a card unattended.
IMPL_TRANSPORT=claude

# Orca transport tuning (ignored for claude). PREFER PINNING THE HANDLE: TUI agents
# overwrite their own tab title on startup (field-tested: omp renamed the tab
# `impl` -> `Pi` and title discovery went stale mid-setup), so a title substring is
# a temporary convenience at best. Get the handle from `orca terminal list --json`
# right before the run; handles are runtime-issued and die on app restart, so
# re-pin per run. Fallback discovery: worktreePath==WORKDIR (+ connected+writable),
# optionally narrowed by ORCA_TERMINAL_TITLE — exactly ONE match required.
# ORCA_TERMINAL_HANDLE=term_...   # preferred
# ORCA_TERMINAL_TITLE=impl        # fallback only; agents rename their tabs
# CARD_TIMEOUT=2700          # max seconds to wait for one card before halting
# POLL_SECS=30               # journal poll interval (seconds)
# ORCA_IDLE_TIMEOUT_MS=60000 # wait-for-tui-idle budget before each send
# ORCA_RESET_CMD=            # optional per-card TUI reset command (e.g. /clear); empty = off

# --- loop guards ---------------------------------------------------------------
# HALT after this many CONSECUTIVE failed impl runs (in-run thrash guard; the
# durable stop is the contract's attempts>=3 -> blocked -> hunt).
MAX_CONSEC_FAIL=2

# 1 = auto-continue informed retries (failed -> impl, attempts<3) on the cheap model.
# 0 = HALT on every impl failure so a human inspects it.
RETRY_ON_FAIL=1

# Path to the settings template carrying the merge-deny hook (default: alongside
# drive.sh). drive.sh renders the absolute hook path into a temp copy at runtime.
# SETTINGS=/abs/path/to/settings.driver.json
